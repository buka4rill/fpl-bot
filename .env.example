# FPL account
FPL_TEAM_ID=
# FPL's write auth is OIDC (PingOne DaVinci) with a bot-guarded login step —
# there's no scripted login. Capture this manually from a logged-in browser
# session instead: DevTools console, on fantasy.premierleague.com,
#   JSON.parse(localStorage.getItem('oidc.user:https://account.premierleague.com/as:bfcbaf69-aade-4c1b-8f00-c1cb8a193030')).refresh_token
# See project memory: fpl-write-api-contract for the full capture steps.
FPL_REFRESH_TOKEN=

# Auth — `pnpm run auth:login` automates the manual capture above (opens a
# real browser, you log in yourself, it pushes the resulting token here).
# AUTH_PUSH_SECRET guards POST /auth/token — the script and the running app
# must share the same value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PUSH_SECRET=
# Where the running app is — only read by scripts/auth-login.ts, not the
# app itself. Defaults to http://localhost:3000 if unset; point this at a
# deployed URL once this app is hosted somewhere other than your machine.
AUTH_TARGET_URL=http://localhost:3000

# Telegram bot (alerts + approval channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler
DEADLINE_LEAD_HOURS=24

# Optimizer — how conservative the transfer-hit recommendation is.
# maxHitsPerWeek caps how many paid transfers (hits) can be suggested in a
# single gameweek, regardless of predicted gain (Wildcard/Free Hit weeks are
# unaffected — those make transfers free). hitRiskPremium is added on top of
# the real 4-pt FPL hit cost inside the solver's own decision-making only —
# it does not change the actual hitCost reported/deducted, just how large a
# predicted gain has to be before a hit gets recommended at all.
OPTIMIZER_MAX_HITS_PER_WEEK=1
OPTIMIZER_HIT_RISK_PREMIUM=4

# chipRiskPremium — same "internal decision threshold, not a real cost"
# pattern as hitRiskPremium, but for chips: ChipEvaluatorService's
# same-week comparison (see CLAUDE.md) would otherwise recommend a chip
# almost every week, since Bench Boost/Triple Captain's bonus points are
# structurally ~free with nothing pricing in that a chip is a scarce,
# once-or-twice-a-season resource. A chip's real expected gain has to
# exceed this many points before it's picked over doing nothing — the
# reported/stored expectedGain is unaffected either way.
OPTIMIZER_CHIP_RISK_PREMIUM=8

# Database (local Postgres via `pnpm db:up`, see docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fpl_bot
DATABASE_USER=fpl_bot
DATABASE_PASSWORD=fpl_bot
